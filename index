<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>nevgero</title>
<style>
  :root{
    --bg:#ffffff;
    --bg-alt:#f5f5f7;
    --text:#1d1d1f;
    --muted:#6e6e73;
    --line:rgba(0,0,0,0.09);
    --accent:#0071e3;
    --accent-hover:#0077ed;
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",system-ui,"Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  a{color:inherit; text-decoration:none;}
  ::selection{background:rgba(0,113,227,0.15); color:var(--accent);}

  .wrap{ max-width:980px; margin:0 auto; padding:0 22px; }

  /* ---------- nav ---------- */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:50;
    height:52px; display:flex; align-items:center; justify-content:center;
    background:rgba(255,255,255,0.8);
    backdrop-filter:blur(20px) saturate(180%);
    -webkit-backdrop-filter:blur(20px) saturate(180%);
    border-bottom:1px solid var(--line);
  }
  nav .inner{
    width:100%; max-width:980px; padding:0 22px;
    display:flex; align-items:center; justify-content:space-between;
  }
  nav .brand{ font-size:14px; font-weight:600; letter-spacing:-0.01em; }
  nav .links{ display:flex; gap:28px; }
  nav .links a{ font-size:12.5px; color:var(--text); opacity:0.75; transition:opacity .2s ease; }
  nav .links a:hover{ opacity:1; }
  @media (max-width:734px){ nav .links{ display:none; } }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:140px 22px 60px;
    overflow:hidden;
  }

  #net{ position:absolute; inset:0; z-index:0; width:100%; height:100%; opacity:0.5; }

  .hero .content{ position:relative; z-index:1; }

  .kicker{
    font-size:13px; font-weight:600; color:var(--muted); letter-spacing:0.01em;
    opacity:0; animation:rise .8s cubic-bezier(.28,.11,.32,1) forwards .1s;
  }

  h1{
    font-size:clamp(44px,8.5vw,84px); font-weight:600; letter-spacing:-0.03em; line-height:1.05;
    margin-top:6px;
    opacity:0; animation:rise .9s cubic-bezier(.28,.11,.32,1) forwards .22s;
  }

  .tagline{
    margin-top:18px; font-size:clamp(19px,2.6vw,26px); font-weight:500; color:var(--muted);
    letter-spacing:-0.01em;
    opacity:0; animation:rise .9s cubic-bezier(.28,.11,.32,1) forwards .38s;
  }

  .quote{
    margin-top:10px; font-size:14px; color:var(--muted); opacity:0;
    animation:rise .9s cubic-bezier(.28,.11,.32,1) forwards .5s;
  }

  .cta-row{
    margin-top:34px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;
    opacity:0; animation:rise .9s cubic-bezier(.28,.11,.32,1) forwards .64s;
  }

  .btn{
    padding:13px 24px; border-radius:980px; font-size:15px; font-weight:500;
    transition:background .25s ease, transform .25s ease;
    display:inline-block;
  }
  .btn.primary{ background:var(--accent); color:#fff; }
  .btn.primary:hover{ background:var(--accent-hover); transform:translateY(-1px); }
  .btn.text{ color:var(--accent); padding:13px 6px; }
  .btn.text:hover{ text-decoration:underline; }

  @keyframes rise{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:translateY(0);} }

  /* ---------- section shell ---------- */
  section{ position:relative; padding:96px 0; }
  section.alt{ background:var(--bg-alt); }

  .section-head{ text-align:center; max-width:600px; margin:0 auto 56px; }
  .section-head h2{
    font-size:clamp(30px,4.6vw,44px); font-weight:600; letter-spacing:-0.02em;
  }
  .section-head p{ margin-top:12px; font-size:16px; color:var(--muted); line-height:1.5; }

  .reveal{ opacity:0; transform:translateY(22px); transition:opacity .8s cubic-bezier(.28,.11,.32,1), transform .8s cubic-bezier(.28,.11,.32,1); }
  .reveal.in{ opacity:1; transform:translateY(0); }

  /* ---------- link rows (apple support style) ---------- */
  .rows{
    background:var(--bg); border-radius:18px; overflow:hidden;
    box-shadow:0 1px 2px rgba(0,0,0,0.04);
  }
  section.alt .rows{ background:#fff; }

  .row{
    display:flex; align-items:center; justify-content:space-between;
    padding:22px 28px; border-bottom:1px solid var(--line);
    transition:background .2s ease;
  }
  .row:last-child{ border-bottom:none; }
  a.row:hover{ background:rgba(0,0,0,0.02); }

  .row .left{ display:flex; flex-direction:column; gap:3px; }
  .row .left .label{ font-size:16px; font-weight:500; }
  .row .left .value{ font-size:14px; color:var(--muted); }
  .row .chev{ font-size:18px; color:var(--muted); transition:transform .25s ease; }
  a.row:hover .chev{ transform:translateX(3px); color:var(--accent); }

  .row.static:hover{ background:none; }
  .row.static .chev{ display:none; }

  .row .price{ font-size:16px; font-weight:600; color:var(--text); white-space:nowrap; }
  .row .price.muted{ font-weight:500; color:var(--muted); font-size:14px; }

  .dm-note{ text-align:center; margin-top:22px; font-size:14px; color:var(--muted); }
  .dm-note a{ color:var(--accent); }
  .dm-note a:hover{ text-decoration:underline; }

  .copy-btn{
    border:1px solid var(--line); background:transparent; color:var(--text);
    padding:8px 16px; border-radius:980px; font-size:13px; cursor:pointer;
    transition:border-color .2s ease, color .2s ease;
  }
  .copy-btn:hover{ border-color:var(--accent); color:var(--accent); }

  /* ---------- footer ---------- */
  footer{
    padding:44px 0 36px; text-align:center; border-top:1px solid var(--line);
  }
  footer .note{ font-size:13px; color:var(--muted); margin-bottom:10px; }
  footer .copy{ font-size:12px; color:var(--muted); }

  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:var(--bg); }
  ::-webkit-scrollbar-thumb{ background:#d2d2d7; border-radius:10px; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
  }

  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; border-radius:6px; }
</style>
</head>
<body>

